# Experiment outputs. results/experiments/ holds the small published summary
# JSONs that regenerate every paper figure and table; everything heavy
# (activations, probe weights, per-sample splits) is regenerated locally.
results/activations_*/
results/analysis/
*.npy
*.npz
*.pt
*.pth
*.ckpt
